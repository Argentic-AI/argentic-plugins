{
  "name": "@argentic-labs/client",
  "version": "0.1.12",
  "description": "Argentic client for TypeScript. The engine runs your agent for hours, rebuilding each prompt from a journal (state blocks plus a recent tail of about 40K tokens) instead of an ever-growing transcript. Adapters for the Vercel AI SDK and Mastra.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/argentic.js",
  "bin": { "argentic": "./dist/cli.js" },
  "types": "./dist/argentic.d.ts",
  "exports": {
    ".": { "types": "./dist/argentic.d.ts", "default": "./dist/argentic.js" },
    "./ai-sdk": { "types": "./dist/ai-sdk.d.ts", "default": "./dist/ai-sdk.js" },
    "./mastra": { "types": "./dist/mastra.d.ts", "default": "./dist/mastra.js" },
    "./tools": { "types": "./dist/tools.d.ts", "default": "./dist/tools.js" }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "ai": ">=5 <8"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Argentic-AI/argentic-plugins.git",
    "directory": "adapters/typescript"
  },
  "homepage": "https://getargentic.com/docs",
  "keywords": ["agents", "long-running", "context", "journal", "ai-sdk", "mastra", "argentic"],
  "publishConfig": { "access": "public", "provenance": true }
}
