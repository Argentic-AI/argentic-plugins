# Argentic API key (aek_...). Make one at https://getargentic.com/platform -> Keys. Required.
ARGENTIC_API_KEY=

# Your model provider's key, for `npm run dev` only. DO NOT set this on a public deployment: it is ignored
# there on purpose, because anyone could otherwise run your model key up. Visitors paste their own key in the page.
MODEL_KEY=

# Optional: pin the model for every visitor. There is no default: without these the page asks each visitor to name one
# (and they paste a key for that model's provider). Give a provider name or an https address, not both.
# Prices are dollars per million tokens (0 for a free model).
# ARGENTIC_MODEL_PROVIDER=
# ARGENTIC_MODEL_BASE_URL=
# ARGENTIC_MODEL_ID=
# ARGENTIC_PRICE_IN=
# ARGENTIC_PRICE_OUT=

# Optional: keeps each visitor's run and sandbox inbox between requests on Vercel.
# Add the Upstash Redis integration and these fill in by themselves (KV_REST_API_URL and KV_REST_API_TOKEN also work).
# Without it the template keeps state in the server's temp folder, which is fine locally but
# can vanish between requests on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: runs one IP address may start per hour (default 20).
# RUNS_PER_IP_HOUR=20

# Optional: seconds each tool pretends to work, so there is time to press Kill. Default 2.5.
# ACTION_DELAY_MS=2500

# Optional: point at another Argentic API or dashboard.
# ARGENTIC_BASE_URL=
# ARGENTIC_DASHBOARD_URL=https://getargentic.com
