{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "argentic",
  "version": "0.3.2",
  "description": "Argentic MCP server: run and inspect long-running agents on Argentic.",
  "author": { "name": "Argentic", "url": "https://getargentic.com" },
  "homepage": "https://getargentic.com/docs",
  "license": "MIT",
  "keywords": ["agents", "memory", "mcp", "argentic"],
  "extensions": {
    "com.openai": {
      "mcpServers": {
        "argentic": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" }
          }
        }
      },
      "interface": {
        "displayName": "Argentic",
        "shortDescription": "Run and inspect long-running agents.",
        "developerName": "Argentic",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://getargentic.com",
        "supportURL": "https://getargentic.com/docs",
        "privacyPolicyURL": "https://getargentic.com/privacy",
        "termsOfServiceURL": "https://getargentic.com/terms",
        "defaultPrompt": [
          "Show my Argentic account and this month's usage",
          "List the recent wakes for my agent and read its journal"
        ],
        "brandColor": "#000000",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
